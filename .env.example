# Contact details (all pages, footer, metadata, enquiry form, WhatsApp links use these)
# Official email: photographyee9@gmail.com
# Official WhatsApp: +2349017448846 (09017444846)

# ...

# Email delivery for the enquiry form.
# The form sends two emails with every valid submission:
#   1. A business notification to ENQUIRY_TO_EMAIL (the studio).
#   2. A confirmation copy to the visitor's email address.
# Both are sent with SMTP via nodemailer. No Resend, no WhatsApp Business API, no credentials in
# client-side code. The form never reports success unless the mail server accepted BOTH emails.
#
# The smallest real setup uses the studio's own email account. For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          # false = STARTTLS on 587; set true only when port is 465
#   SMTP_USER=photographyee9@gmail.com
#   SMTP_PASS=<your Gmail app password, not your normal password>
#   ENQUIRY_TO_EMAIL=photographyee9@gmail.com
#   ENQUIRY_FROM_EMAIL="E&E Photography <photographyee9@gmail.com>"
#
# If SMTP is not configured, the form answers 503 "not configured" and keeps showing the WhatsApp
# button as the working contact method. It never pretends an email was sent.
#
# Spam / rate protection: a simple in-server IP rate limit and payload dedup are built into the
# /api/enquiry route (best-effort for a single server). A hidden honeypot field catches bots too.
# For heavier protection, add a CAPTCHA of your choice — but do not send its secret here.

# Public URL of the deployed site (canonical URLs, sitemap, social sharing previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Required for email delivery of the enquiry form (see notes above).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO_EMAIL=photographyee9@gmail.com
ENQUIRY_FROM_EMAIL="E&E Photography <photographyee9@gmail.com>"

# WhatsApp click-to-chat uses the phone number in src/config/brand.ts.
# No WhatsApp Business API, access token, or phone-number ID is used or needed.

# Google Analytics 4 (optional). Analytics and its consent banner stay off until this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification (optional; DNS verification needs nothing here).
GOOGLE_SITE_VERIFICATION=
